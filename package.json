{
  "name": "study-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paste notes, get flashcards and a quiz. AI output is validated before it ever reaches the UI.",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,magenta \"npm:server\" \"npm:dev\"",
    "dev": "vite",
    "server": "node server/index.js",
    "server:watch": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "vite": "^6.4.6"
  }
}
